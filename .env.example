# CabinWeave 本地配置模板：复制为 .env 后填写，真实 .env 不提交，这里只放占位值。
# docker compose 把 .env 作为后端的 env_file，并用它替换 compose 文件里的变量；后端单独运行时由 python-dotenv 读取。
# 带 # 的可选项保持默认即可，需要时去掉 # 再改值；不要留成空值（部分配置为空时会被当成空路径或解析失败）。

# ── 模型凭据（必填）─────────────────────────────────────────────────────────────
# Anthropic Messages API 密钥
ANTHROPIC_API_KEY=
# 兼容 Anthropic Messages API 的服务地址；留空使用 SDK 默认服务
ANTHROPIC_BASE_URL=
# 默认模型：各角色、意图识别、汇总节点和偏好提炼都用它；代码默认 claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=your-model-name

# ── 各角色模型覆盖（默认用 ANTHROPIC_MODEL；安全节点不调模型）──────────────────
# 车控
# CABINWEAVE_VEHICLE_CONTROL_MODEL=your-model-name
# 导航
# CABINWEAVE_NAVIGATION_MODEL=your-model-name
# 用车顾问（可配更强的模型）
# CABINWEAVE_ADVISOR_MODEL=your-model-name
# 座舱助手（可配更快的模型）
# CABINWEAVE_CABIN_MODEL=your-model-name
# 意图识别（可配更快的小模型）
# CABINWEAVE_INTENT_MODEL=your-model-name

# ── 意图识别 ─────────────────────────────────────────────────────────────────────
# LLM 层超时秒数，超时后用关键词兜底，默认 5.0
# CABINWEAVE_INTENT_TIMEOUT_S=5.0
# 识别结果 LRU 缓存容量，0 表示不缓存，默认 1000
# CABINWEAVE_INTENT_CACHE_SIZE=1000

# ── 汇总节点（多角色且含问答时调模型合并播报）────────────────────────────────────
# max_tokens，默认 1200
# CABINWEAVE_COMPOSER_MAX_TOKENS=1200
# 温度，默认 0.1
# CABINWEAVE_COMPOSER_TEMPERATURE=0.1

# ── 快速通道 ─────────────────────────────────────────────────────────────────────
# 开关 on / off（off、0、false、no 为关闭），默认 on
# CABINWEAVE_FAST_PATH=on

# ── 车辆 ─────────────────────────────────────────────────────────────────────────
# 新车和 /vehicle/reset 使用的场景：parked、city_driving、highway、low_battery、tpms_warning、winter，默认 parked
# CABINWEAVE_VEHICLE_DEFAULT_SCENARIO=parked

# ── Skills ───────────────────────────────────────────────────────────────────────
# Skill 目录，默认 backend/skills（docker compose 里固定为 /app/skills，这里改了不生效）
# CABINWEAVE_SKILLS_DIR=./skills
# 一次请求注入的 Skill 合计字符上限，默认 5000
# CABINWEAVE_SKILLS_MAX_PROMPT_CHARS=5000

# ── 车辆用户手册（知识库）─────────────────────────────────────────────────────────
# 手册目录，启动时按目录同步进知识库，默认 backend/manuals（docker compose 里固定为 /app/manuals）
# CABINWEAVE_MANUALS_DIR=./manuals

# ── 工具调用记录 ─────────────────────────────────────────────────────────────────
# 内存中保留的请求级工具调用记录条数（/trace/tools），默认 200
# CABINWEAVE_TOOL_TRACE_MAX=200

# ── 存储（Redis / ChromaDB）───────────────────────────────────────────────────────
# Redis 密码，docker compose 必填；建议用字母和数字组成的随机密码，避免 Redis URL 中的保留字符
REDIS_PASSWORD=change-this-local-password
# 以下四项 docker compose 里已固定，只在后端单独运行时需要
# Redis 地址，默认 redis://redis:6379/0
# REDIS_URL=redis://:change-this-local-password@localhost:6379/0
# ChromaDB 服务地址，默认 chromadb
# CHROMA_HOST=localhost
# ChromaDB 服务端口，默认 8000
# CHROMA_PORT=8000
# 连不上 ChromaDB 服务时改用本地嵌入式存储的目录，默认 /app/data/chroma
# CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 端口（docker compose 映射到本机）────────────────────────────────────────────
# 后端端口，默认 8000
BACKEND_PORT=8000
# 前端端口，默认 5173
FRONTEND_PORT=5173

# ── 监控与日志 ───────────────────────────────────────────────────────────────────
# 日志级别，默认 INFO
LOG_LEVEL=INFO
# 告警 Webhook 地址，留空不发送
ALERT_WEBHOOK_URL=
# 监控采样间隔秒数，默认 10
# MONITOR_INTERVAL=10
# Prometheus 独立端口，0 表示不启动，默认 0（/metrics 接口不受影响；docker compose 里固定为 0）
# PROMETHEUS_PORT=0

# ── 后端直接运行（python api/main.py）──────────────────────────────────────────
# 监听地址，默认 0.0.0.0
# API_HOST=0.0.0.0
# 监听端口，默认 8000
# API_PORT=8000
# 设为 development 时开启自动重载
# APP_ENV=development
